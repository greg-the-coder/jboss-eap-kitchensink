{
    "name": "Kitchensink Spring Boot + Next.js",
    "dockerComposeFile": "docker-compose.yml",
    "service": "workspace",
    "workspaceFolder": "/workspace",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "pivotal.vscode-spring-boot",
                "vscjava.vscode-gradle",
                "ms-vscode.vscode-typescript-next",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",
                "amazonwebservices.amazon-q-vscode"
            ],
            "settings": {
                "java.home": "/opt/java/openjdk",
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-17",
                        "path": "/opt/java/openjdk",
                        "default": true
                    }
                ],
                "gradle.javaHome": "/opt/java/openjdk",
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "editor.formatOnSave": true,
                "[java]": {
                    "editor.defaultFormatter": "redhat.java"
                },
                "files.exclude": {
                    "**/.gradle": true,
                    "**/build": true,
                    "**/.next": true,
                    "**/node_modules": false
                }
            }
        }
    },
    
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "moby": true
        }
    },
    
    "portsAttributes": {
        "3001": {
            "label": "Frontend (Container)",
            "onAutoForward": "notify"
        },
        "8081": {
            "label": "Backend (Container)",
            "onAutoForward": "notify"
        },
        "3306": {
            "label": "MySQL Database",
            "onAutoForward": "silent"
        },
        "5006": {
            "label": "Java Debug",
            "onAutoForward": "silent"
        }
    },
    
    "postCreateCommand": "cd /workspace && chmod +x *.sh && cd frontend && npm install",
    
    "postStartCommand": "echo '✅ Devcontainer ready! Use ./launch-backend.sh and ./launch-frontend.sh to start services'",
    
    "remoteEnv": {
        "JAVA_HOME": "/opt/java/openjdk",
        "SPRING_PROFILES_ACTIVE": "dev",
        "NEXT_PUBLIC_API_URL": "http://localhost:8081"
    },
    
    "remoteUser": "root"
}